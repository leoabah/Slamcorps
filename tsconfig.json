{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "Backend/**/*.js",
    "Frontend/src/**/*.{js,jsx,ts,tsx}"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/.git"
  ]
}
